# Copy this file to .env.local and fill in your own keys. .env.local is git-ignored. Never commit real keys.
# All providers below have free tiers. AMAN never enables billing and only uses OpenRouter ":free" models.

# AI provider priority: Gemini -> Groq -> OpenRouter -> deterministic engine (always available)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Internet research (Tavily)
TAVILY_API_KEY=

# Optional model overrides (comma-separated, tried in order). Defaults were verified on 2026-11-24.
# GEMINI_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest
# GROQ_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
# OPENROUTER_MODELS=baidu/ernie-5.5-flash-preview:free,nvidia/nemotron-3.5-super-vl:free

# Optional: where Secure Deal transactions and the threat feed are stored (default ./.data)
# AMAN_DATA_DIR=
